{
  "name": "@xiuxiu/desktop",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "main": "gui/main.mjs",
  "author": "downloader-dev",
  "description": "嗅嗅下载器桌面端宿主（native messaging）+ 下载核心 + Electron GUI",
  "scripts": {
    "gui": "electron .",
    "pack": "electron-builder --win portable",
    "download": "node cli.mjs",
    "media": "node media-cli.mjs",
    "register": "node register-host.mjs",
    "unregister": "node register-host.mjs --unregister",
    "test": "node --test --test-timeout 60000 tests/protocol.test.mjs tests/host.test.mjs tests/downloader.test.mjs tests/hls.test.mjs tests/dash.test.mjs tests/segments.test.mjs tests/media-e2e.test.mjs tests/queue.test.mjs tests/bili.test.mjs tests/stream.test.mjs"
  },
  "build": {
    "appId": "com.downloader.sniffer",
    "productName": "嗅嗅下载器",
    "files": ["gui/**/*", "lib/**/*", "build/icon.png", "build/tray-16.png", "build/tray-24.png", "build/tray-32.png", "build/tray-16-active.png", "build/tray-24-active.png", "build/tray-32-active.png", "package.json"],
    "win": { "target": ["portable"], "icon": "build/icon.png" },
    "portable": { "artifactName": "xiuxiu-downloader-${version}-portable.exe" },
    "electronLanguages": ["zh-CN", "en-US"]
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
