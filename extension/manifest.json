{
  "manifest_version": 3,
  "name": "嗅探下载器",
  "short_name": "嗅探下载",
  "version": "0.1.0",
  "description": "通用媒体嗅探器：捕获网页中的视频/音频/HLS/DASH 地址，配合桌面端多线程下载器使用。",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "嗅探下载器",
    "default_popup": "popup.html"
  }
}
