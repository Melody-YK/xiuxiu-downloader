{
  "manifest_version": 3,
  "name": "嗅嗅下载器",
  "short_name": "嗅嗅",
  "version": "0.1.0",
  "description": "通用媒体嗅探器：捕获网页中的视频/音频/HLS/DASH 地址，配合桌面端多线程下载器使用。",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "嗅嗅下载器",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
